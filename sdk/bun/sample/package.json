{
  "name": "@core3/services",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "bun run css:build:global && bun run css:build:auth && bun run css:build:chat && bun run css:build:order && bun run css:build:crm && bun run css:build:point-of-sale && bun run css:build:sale-subscription && bun run css:build:sale-renting",
    "css:build:global": "sass --no-source-map public/styles/global.scss public/styles/global.css",
    "css:build:auth": "sass --no-source-map services/auth/styles/index.scss services/auth/styles/index.css",
    "css:build:chat": "sass --no-source-map services/chat/styles/index.scss services/chat/styles/index.css",
    "css:build:order": "sass --no-source-map services/order/styles/index.scss services/order/styles/index.css",
    "css:build:crm": "sass --no-source-map services/crm/styles/index.scss services/crm/styles/index.css",
    "css:build:point-of-sale": "sass --no-source-map services/point_of_sale/styles/index.scss services/point_of_sale/styles/index.css",
    "css:build:sale-subscription": "sass --no-source-map services/sale_subscription/styles/index.scss services/sale_subscription/styles/index.css",
    "css:build:sale-renting": "sass --no-source-map services/sale_renting/styles/index.scss services/sale_renting/styles/index.css",
    "prestart": "bun run css:build",
    "start": "PORT=3001 bun server.ts",
    "predev": "bun run css:build",
    "dev": "bun scripts/dev.ts",
    "dev:ddb": "bun scripts/dev.ts --db=ddb",
    "dev:memory": "bun scripts/dev.ts --db=ddb --memory",
    "dev:pg": "bun scripts/dev.ts --db=pg",
    "dev:mysql": "bun scripts/dev.ts --db=mysql",
    "dev:oracle": "bun scripts/dev.ts --db=oracle",
    "dev:sqlserver": "bun scripts/dev.ts --db=sqlserver",
    "db:smoke": "bun scripts/adapter-smoke.ts",
    "event-mediator": "bun ../med/src/event-mediator-server.ts",
    "test": "vitest run --environment jsdom --config ../packages/client/vitest.config.ts",
    "audit": "bun scripts/audit-order-ui.ts"
  },
  "dependencies": {
    "@core3/client": "workspace:*",
    "@core3/med": "workspace:*",
    "@core3/server": "workspace:*",
    "@duckdb/node-api": "^1.5.5-r.3",
    "apache-arrow": "^21.2.0",
    "duckdb": "^1.1.0",
    "jose": "^5.9.6",
    "parquet-wasm": "^0.7.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jest-extended": "^4.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "sass": "^1.102.0"
  }
}
