    "start": "CORE3_FRONTEND_DIST=true CORE3_DB_DRIVER=duckdb CORE3_AUTH_DB_DRIVER=duckdb CORE3_ORDER_DB_DRIVER=duckdb CORE3_CHAT_DB_DRIVER=duckdb PORT=3001 bun server.ts",
    "start:built": "CORE3_FRONTEND_DIST=true CORE3_DB_DRIVER=duckdb CORE3_AUTH_DB_DRIVER=duckdb CORE3_ORDER_DB_DRIVER=duckdb CORE3_CHAT_DB_DRIVER=duckdb PORT=3001 bun server.ts",
    "dev": "bun scripts/dev.ts",
    "frontend:dev": "vite --config vite.config.ts",
    "frontend:build": "bun run css:build && vite build --config vite.config.ts",
    "dev:ddb": "bun scripts/dev.ts --db=ddb",
    "dev:memory": "bun scripts/dev.ts --memory",
    "dev:pg": "bun scripts/dev.ts --db=pg",
    "dev:mysql": "bun scripts/dev.ts --db=mysql",
    "dev:oracle": "bun scripts/dev.ts --db=oracle",
    "dev:sqlserver": "bun scripts/dev.ts --db=sqlserver",
    "db:smoke": "bun scripts/adapter-smoke.ts",
    "event-mediator": "bun ../med/src/event-mediator-server.ts",
    "test": "vitest run --environment jsdom --config ../packages/client/vitest.config.ts",
    "test:integration": "bun test test/**/*.integration.test.ts",
    "audit": "bun scripts/audit-order-ui.ts"
  },
  "dependencies": {
    "@core3/client": "workspace:*",
    "@core3/med": "workspace:*",
    "@core3/server": "workspace:*",
