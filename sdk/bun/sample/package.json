{
  "name": "@core3/services",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "sass --no-source-map public/styles/index.scss public/styles/index.css",
    "prestart": "bun run css:build",
    "start": "PORT=3001 bun server.ts",
    "predev": "bun run css:build",
    "dev": "bun scripts/dev.ts",
    "dev:ddb": "bun scripts/dev.ts --db=ddb",
    "dev:memory": "bun scripts/dev.ts --db=ddb --memory",
    "dev:pg": "bun scripts/dev.ts --db=pg",
    "event-mediator": "bun ../med/src/event-mediator-server.ts",
    "test": "vitest run --environment jsdom --config ../packages/client/vitest.config.ts",
    "audit": "bun scripts/audit-order-ui.ts"
  },
  "dependencies": {
    "@core3/client": "workspace:*",
    "@core3/med": "workspace:*",
    "@core3/server": "workspace:*",
    "@duckdb/node-api": "^1.5.5-r.3",
    "apache-arrow": "^21.2.0",
    "duckdb": "^1.1.0",
    "jose": "^5.9.6",
    "parquet-wasm": "^0.7.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jest-extended": "^4.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "sass": "^1.102.0"
  }
}
