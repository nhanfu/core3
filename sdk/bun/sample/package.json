    "jose": "^5.9.6",
    "parquet-wasm": "^0.7.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jest-extended": "^4.0.0",
    "jsdom": "^25.0.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^3.0.0"
