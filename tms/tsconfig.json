{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["./*.ts", "./*.d.ts", "./components/*.ts", "./components/*.d.ts", "./pages/*.ts", "./pages/*.d.ts"]
}
