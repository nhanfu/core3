{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "paths": {
      "@core3/framework": ["./types/framework.d.ts"],
      "@core3/framework/*": ["./types/framework.d.ts"]
    },
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "./*.ts",
    "./*.d.ts",
    "./components/*.ts",
    "./components/*.d.ts",
    "./pages/*.ts",
    "./pages/*.d.ts",
    "./types/*.d.ts"
  ]
}
